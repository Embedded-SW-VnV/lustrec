	= (idChart_Run_1, idChart_Chart_1, x_1, idChart_Stop_1, idStop_Reset_1, cent_1, disp_cent_1, disp_min_1, disp_sec_1, min_1, sec_1);
	

	tel

	until true restart POINTChart_Run



tel


